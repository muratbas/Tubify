{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tubify",
  "version": "0.1.0",
  "identifier": "com.tubify.music",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tubify",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 850,
        "minHeight": 550,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1RURCQkEzNEEyMDY1NUUKUldSZVpTQktvN3Z0MVQwaUtqRElkZ2hjMWk5alFGdis0MFlOZkc1eWNSV1JJQkpJVzVkcXFEYWwK",
      "endpoints": [
        "https://github.com/muratbas/Tubify/releases/latest/download/latest.json"
      ]
    }
  }
}
